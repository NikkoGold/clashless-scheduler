# Copy to .env and fill in. .env is git-ignored.

# Set to false to always use the offline rule-based parser
LLM_ENABLED=true

# gemini | anthropic | openai | ollama | none
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest

# Only the key for the selected provider is needed
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Used when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# After this many LLM calls in a day, the router falls back to the rule parser
LLM_MAX_CALLS_PER_DAY=50
