# Usually not needed: `python -m scheduler setup` saves these to a user-wide file that works from any folder.
# A .env in the folder you run from (copy this file) replaces that file entirely. .env is git-ignored.

# gemini | anthropic | openai | ollama | none (none = offline, rules only)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Only the key for the selected provider is needed
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Used when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# After this many LLM calls in a day, the router falls back to the rule parser
LLM_MAX_CALLS_PER_DAY=50
